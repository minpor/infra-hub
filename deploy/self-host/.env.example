# Copy to .env; never commit the filled-in file.
HUB_DOMAIN=hub.example.com
HUB_DATABASE_PASSWORD=replace-with-a-long-random-password
HUB_GITHUB_CLIENT_ID=replace-with-your-oauth-client-id
HUB_GITHUB_CLIENT_SECRET=replace-with-your-oauth-client-secret
# Numeric GitHub user ID, not the login name.
HUB_OWNER_GITHUB_ID=12345678
# Optional repository runner overlay (see docs/self-hosting.md).
HUB_WORKER_SECRET=replace-with-at-least-32-random-characters
HUB_RUNNER_UID=1001
HUB_RUNNER_SOCKET_GID=1001
HUB_GITHUB_APP_ID=
HUB_GITHUB_INSTALLATION_ID=
HUB_IMAGE_NAMESPACE=localhost:5000/infra-hub
# A Java 21 runtime reference including @sha256:<64 hex characters>.
HUB_RUNTIME_IMAGE=
