# General Java 21 / Node.js runner. Android requires a separate SDK-equipped image.
FROM eclipse-temurin:21-jdk-jammy AS jdk
FROM node:22-bookworm-slim
COPY --from=jdk /opt/java/openjdk/ /opt/java/openjdk/
ENV JAVA_HOME=/opt/java/openjdk PATH=/opt/java/openjdk/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY dependency-proxy.py proxy-bridge.py run-build /opt/hub/
RUN chmod 755 /opt/hub/run-build && mkdir /cache && chown 10001:10001 /cache
USER 10001:10001
WORKDIR /work
