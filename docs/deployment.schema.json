{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Infra Hub deployment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "build",
    "deploy"
  ],
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "run"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900,
          "default": 300
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "artifact": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*\\.jar$"
        },
        "cache": {
          "type": "boolean",
          "description": "Override the project dependency cache setting. Omit to inherit."
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "steps",
        "verify"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^/.+"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "verify": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "rollback": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    }
  }
}
